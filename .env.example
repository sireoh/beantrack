# BeanTrack: configuration for docker compose. Copy to `.env` next to docker-compose.yml.
# Never commit .env. Values below are placeholders for a local run at http://localhost:8080;
# the "Production" comments show what to use on https://beantrack.vincefung.cc.

# --- Images ------------------------------------------------------------------------
# Registry path (lowercase) and tags `docker compose pull` uses.
IMAGE_REPO=ghcr.io/sireoh/beantrack
BACKEND_TAG=backend
FRONTEND_TAG=frontend

# --- Ports / networking ------------------------------------------------------------
# Host port (optionally ip:port) where the site is published. Production behind a reverse
# proxy on the same machine: 127.0.0.1:8080
FRONTEND_PUBLISH=127.0.0.1:4736
# Port nginx listens on inside the frontend container.
NGINX_PORT=8080
# Host port (optionally ip:port) where the API is published.
BACKEND_PUBLISH=127.0.0.1:8000
# Port the API listens on inside the backend container.
BACKEND_PORT=8000
# Proxies whose X-Forwarded-* headers uvicorn trusts. Only nginx can reach the API, so * is fine.
FORWARDED_ALLOW_IPS=*
# Largest request nginx accepts (watchlist imports).
NGINX_MAX_BODY_SIZE=10m

# --- Public URLs -------------------------------------------------------------------
# Where the browser lands after Discord login. Production: https://beantrack.vincefung.cc/
FRONTEND_URL=http://localhost:8080/
# The public site URL + /api/auth/callback; must also be registered in the Discord app.
# Production: https://beantrack.vincefung.cc/api/auth/callback
DISCORD_REDIRECT_URI=http://localhost:8080/api/auth/callback
# Origins allowed to call the API cross-origin with cookies (JSON list). The site calls the
# API on its own origin through nginx, so this only matters if something else calls it.
# Production: ["https://beantrack.vincefung.cc"]
CORS_ORIGINS=["http://localhost:8080"]

# --- Session cookie ----------------------------------------------------------------
# true sends the cookie over HTTPS only. Production (HTTPS): true. Local http://: false
COOKIE_SECURE=false
SESSION_TTL_DAYS=30
SESSION_COOKIE_NAME=beantrack_session

# --- Secrets / API keys --------------------------------------------------------------
# Discord application (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
# OMDb (https://www.omdbapi.com/apikey.aspx)
OMDB_API_KEY=your-omdb-api-key
# Fernet key that encrypts Discord tokens in the database. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it backed up; changing it makes stored Discord tokens unreadable (users log in again).
ENCRYPTION_KEY=generate-a-fernet-key

# --- Database --------------------------------------------------------------------------
# Where the SQLite database lives on the host: a named volume (default) or a host path.
# For a host path such as ./data, make it writable by the container user first:
#   mkdir -p data && sudo chown 10001:10001 data
DATA_VOLUME=beantrack-data
DATABASE_NAME=beantrack.db

# --- Backblaze B2 (manual backups + Litestream) ------------------------------------------
# Application key restricted to the bucket. Leave empty to disable both.
B2_KEY_ID=your-b2-key-id
B2_APPLICATION_KEY=your-b2-application-key
B2_BUCKET_NAME=your-bucket-name
# S3 endpoint of the bucket's region (used by Litestream).
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# false = never run Litestream, even when the B2 values above are set.
LITESTREAM_ENABLED=true

# --- Wasabi Storage ---------------------------------------------------------------------
DIRECTORY=./data