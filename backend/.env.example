# Copy to backend/.env and fill in. Never commit .env.

# --- Storage ---------------------------------------------------------------
# Folder holding the SQLite database (created on startup if missing). Server-only, gitignored.
DATA_DIR=./data
DATABASE_NAME=beantrack.db

# --- Discord OAuth2 (https://discord.com/developers/applications) -----------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must exactly match a redirect registered on the Discord application.
DISCORD_REDIRECT_URI=http://127.0.0.1:8000/api/auth/callback

# --- OMDb (https://www.omdbapi.com/apikey.aspx) -----------------------------
OMDB_API_KEY=

# --- TMDB (https://www.themoviedb.org/settings/api) -------------------------
# "API Read Access Token" for the Discover pages. Leave empty to turn Discover off.
TMDB_BEARER_TOKEN=
# DISCOVER_CACHE_HOURS=24

# --- Encryption of Discord tokens at rest ----------------------------------
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing or changing this key makes stored Discord tokens unreadable (users just log in again).
ENCRYPTION_KEY=

# --- Backblaze B2 backups (optional; leave empty to turn backups off) --------
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
# One snapshot a day at this local time; the newest DAILY_BACKUP_KEEP are kept.
# DAILY_BACKUP_ENABLED=true
# DAILY_BACKUP_TIME=03:00
# DAILY_BACKUP_TIMEZONE=UTC
# DAILY_BACKUP_KEEP=7

# --- Optional (defaults shown) ---------------------------------------------
# SESSION_TTL_DAYS=30
# SESSION_COOKIE_NAME=beantrack_session
# Set to false only for local development over plain http.
COOKIE_SECURE=false
# Where the browser lands after logging in (the SvelteKit app in development).
# FRONTEND_URL=http://127.0.0.1:5173/
# Origins allowed to call the API with cookies (JSON list).
# CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
# Proxies trusted to report the client IP (comma-separated IPs/CIDRs). The Vite dev server
# proxies from 127.0.0.1, so the default records the real IP of devices on your LAN too.
# FORWARDED_ALLOW_IPS=127.0.0.1
