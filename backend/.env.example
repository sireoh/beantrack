# Copy to backend/.env for local development. Real environment variables
# always win over values in .env.

# --- App (required) ---------------------------------------------------------

# HTTP port; the server listens on 0.0.0.0:$PORT.
PORT=
# Folder that holds beantrack.db. Created if missing. Mount as a volume in a
# container. Locally, ../data puts it in the repo's (git-ignored) data/ folder.
DATA_DIR=

# Discord OAuth2 app: https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must exactly match a redirect registered in the Discord app,
# e.g. http://localhost:8080/auth/discord/callback
DISCORD_REDIRECT_URI=

# At least 32 characters. Signs session cookies and encrypts stored Discord
# tokens. Generate with: openssl rand -base64 48
SESSION_SECRET=

# --- App (optional) ---------------------------------------------------------

# Where the browser goes after a successful login. Defaults to "/".
LOGIN_REDIRECT_URL=

# --- Backups: read by Litestream (see litestream.yml) -----------------------
# Leave all of these empty to run without backups. If any is set, the app
# requires all of them, so a missing encryption key can't silently produce an
# unencrypted backup.

B2_BUCKET=
# S3-compatible endpoint, e.g. https://s3.us-west-004.backblazeb2.com
B2_ENDPOINT=
# The region part of the endpoint, e.g. us-west-004
B2_REGION=
B2_KEY_ID=
B2_APPLICATION_KEY=
# Base64 of 32 random bytes (SSE-C, AES-256). Generate with:
#   openssl rand -base64 32
# Keep a copy somewhere safe: without it the backups cannot be restored.
LITESTREAM_ENCRYPTION_KEY=
