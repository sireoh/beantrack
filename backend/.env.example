# Copy to backend/.env and fill in. Never commit .env.

# --- Storage ---------------------------------------------------------------
# Folder holding the SQLite database (created on startup if missing). Server-only, gitignored.
DATA_DIR=./data
DATABASE_NAME=beantrack.db

# --- Discord OAuth2 (https://discord.com/developers/applications) -----------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must exactly match a redirect registered on the Discord application.
DISCORD_REDIRECT_URI=http://localhost:8000/api/auth/callback

# --- OMDb (https://www.omdbapi.com/apikey.aspx) -----------------------------
OMDB_API_KEY=

# --- Encryption of Discord tokens at rest ----------------------------------
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing or changing this key makes stored Discord tokens unreadable (users just log in again).
ENCRYPTION_KEY=

# --- Backblaze B2 (used by Litestream) -------------------------------------
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
# S3 endpoint of the bucket's region, with scheme.
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com

# --- Optional (defaults shown) ---------------------------------------------
# SESSION_TTL_DAYS=30
# SESSION_COOKIE_NAME=beantrack_session
# Set to false only for local development over plain http.
# COOKIE_SECURE=true
# Where the browser lands after logging in (the SvelteKit app in development).
# FRONTEND_URL=http://127.0.0.1:5173/
# Origins allowed to call the API with cookies (JSON list).
# CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
