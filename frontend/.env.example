# Copy to frontend/.env

# Where the dev server forwards /api requests (the FastAPI backend, as seen from this machine).
API_PROXY_TARGET=http://127.0.0.1:8000

# Leave empty: the browser then calls /api on the site itself (through the proxy above),
# which works from a phone on your network too. Only set it if the API is served from a
# different origin in production, e.g. https://api.example.com
PUBLIC_API_URL=

# Default daisyUI theme (any daisyUI theme name). Empty or missing -> "dark".
# A user's own dark/light choice (saved in the browser) overrides this.
PUBLIC_DAISYUI_THEME=dark
