# Copy to frontend/.env

# Base URL of the BeanTrack API (no trailing slash). The dev server binds to the same
# hostname, so open the site on that hostname too (http://127.0.0.1:5173 here).
PUBLIC_API_URL=http://127.0.0.1:8000

# Default daisyUI theme (any daisyUI theme name). Empty or missing -> "dark".
# A user's own dark/light choice (saved in the browser) overrides this.
PUBLIC_DAISYUI_THEME=dark
