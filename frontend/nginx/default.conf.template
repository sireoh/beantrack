# Rendered at container start by the nginx image (envsubst on /etc/nginx/templates/*).
# Only variables that exist in the environment are substituted, so nginx's own $uri,
# $host, ... are left alone.

server {
    listen ${NGINX_PORT};
    server_name _;
    root /usr/share/nginx/html;

    client_max_body_size ${NGINX_MAX_BODY_SIZE};

    # The API, same origin as the site: the session cookie stays first-party and the built
    # frontend never needs to know where the backend lives.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        # Imports and B2 backups/restores can take a while.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # Hashed build assets never change: cache them for a year.
    location /_app/immutable/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Single-page app: unknown paths get index.html (adapter-static fallback).
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
